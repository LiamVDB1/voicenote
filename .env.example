# Copy to .env and edit. Defaults work for local dev.
# For production, set a real VN_SECRET_KEY: `openssl rand -hex 32`.

VN_SECRET_KEY=change-me-in-production

# Engine cascade. Default = Parakeet, with Whisper then Voxtral as fallbacks.
# Each fallback only activates if its model files are present in ./models/.
VN_DEFAULT_ENGINE=parakeet
# Whisper is in the chain so Parakeet failures fall back gracefully — but only
# if you've downloaded its model (`./scripts/download-models.sh whisper`).
# Voxtral is intentionally not in the default chain (binary not in the image).
VN_FALLBACK_CHAIN=whisper

# Tune for your machine. Oracle A1 (4 OCPU): 3 leaves a core free for the system.
# Apple Silicon / Linux desktop: 4–6 is a sweet spot.
VN_INFERENCE_THREADS=3

# Hard cap on simultaneous transcribe jobs. Keep at 1 on a 4-core box —
# a single job already saturates the cores via VN_INFERENCE_THREADS.
VN_MAX_CONCURRENT_JOBS=1

# Use Silero VAD to chunk audio > 30s. Recommended on CPU.
VN_USE_VAD=true

VN_MAX_UPLOAD_MB=200
VN_MAX_AUDIO_MINUTES=180

# Set true once you serve over HTTPS.
VN_COOKIE_SECURE=false

# Resource limits (compose deploy.resources)
VN_CPU_LIMIT=3
VN_MEM_LIMIT=6g

# Model paths (override only if you keep different filenames in ./models/).
VN_PARAKEET_DIR=sherpa-onnx-nemo-parakeet-tdt-0.6b-v3-int8
VN_SILERO_VAD_FILENAME=silero_vad.onnx
VN_WHISPER_MODEL=ggml-large-v3-turbo-q5_0.bin
# Voxtral runs via Mistral's hosted API (~$1 / 1000 minutes for voxtral-mini-transcribe).
# Get a key at https://console.mistral.ai/api-keys
# Leave empty to disable the "Beste" engine option.
VN_MISTRAL_API_KEY=
VN_VOXTRAL_MODEL_NAME=voxtral-mini-latest
